# SALAS stack secrets. Copy to salas/.env (gitignored) and fill with freshly generated values,
# e.g. `openssl rand -hex 32` (hex is safe inside postgres:// and redis:// URLs).
# docker compose refuses to start if any required value below is missing (fail closed).

PG_USER=ark95x
# Postgres password (also used by litellm, salas-api and n8n)
PG_PASSWORD=

# Neo4j password for user neo4j
NEO4J_PASSWORD=

# Redis AUTH password (also used by salas-api REDIS_URL and n8n queue)
REDIS_PASSWORD=

N8N_USER=admin
# n8n basic-auth password (ignored by n8n 1.0+; keep set for older images)
N8N_PASSWORD=

# n8n credential encryption key. EXISTING install: copy it from the n8ndata volume's config file
N8N_ENCRYPTION_KEY=

# Grafana admin password
GRAFANA_PASSWORD=

# LiteLLM proxy master key (required; the proxy is unauthenticated without it)
LITELLM_MASTER_KEY=

# Provider keys (optional)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
PERPLEXITY_API_KEY=
OPENROUTER_API_KEY=
