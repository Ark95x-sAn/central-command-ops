# SALAS stack secrets. Copy to salas/.env (gitignored) and fill with freshly generated values,
# e.g. `openssl rand -hex 32` (hex is safe inside postgres:// URLs).
# docker compose refuses to start if any required value below is missing (fail closed).

PG_USER=ark95x
# Postgres password (also used by litellm, salas-api and n8n)
PG_PASSWORD=

# Neo4j password for user neo4j
NEO4J_PASSWORD=

N8N_USER=admin
# n8n basic-auth password
N8N_PASSWORD=

# n8n credential encryption key. EXISTING install: copy it from the n8ndata volume's config file
N8N_ENCRYPTION_KEY=

# Grafana admin password
GRAFANA_PASSWORD=

# Provider keys (optional)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
PERPLEXITY_API_KEY=
OPENROUTER_API_KEY=
